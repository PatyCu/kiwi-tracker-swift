{
  "permissions": {
    "allow": [
      "Bash(make format-check)",
      "Bash(make format)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make db-types)",
      "Bash(swift format:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(supabase status)",
      "Bash(supabase db lint)",
      "Bash(supabase db push --remote --dry-run)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh" }]
      }
    ]
  }
}
